{
  "schemaVersion": 1,
  "id": "fat-cat",
  "name": "大肥猫",
  "version": "1.3.0",
  "author": "Antigravity Pet Studio",
  "description": "简洁半身大肥猫桌宠，支持透明穿透、按压回弹、物理重力落底、Mac边栏贴合与双周期额度监控",
  "render": {
    "defaultWidth": 136,
    "minWidth": 100,
    "maxWidth": 200,
    "motionPaddingPx": 0,
    "facingTransitionMs": 220
  },
  "frames": {
    "idle": "frames/idle.png"
  },
  "states": {
    "idle": {
      "frame": "idle",
      "motion": "breath",
      "loop": true
    },
    "thinking": {
      "frame": "idle",
      "motion": "ponder",
      "bubbleText": "本喵正在高速运转脑回路...",
      "loop": true
    },
    "working": {
      "frame": "idle",
      "motion": "working",
      "bubbleText": "正在执行工具任务，瞧好吧！",
      "loop": true
    },
    "success": {
      "frame": "idle",
      "motion": "duang",
      "bubbleText": "搞定啦！本喵厉害吧~",
      "durationMs": 3200,
      "loop": false
    },
    "error": {
      "frame": "idle",
      "motion": "worry",
      "bubbleText": "好像遇到报错了，陪你一起排查。",
      "durationMs": 3800,
      "loop": false
    },
    "pressed": {
      "frame": "idle",
      "motion": "compress",
      "loop": false
    },
    "rebound": {
      "frame": "idle",
      "motion": "duang",
      "durationMs": 500,
      "loop": false
    },
    "dragging": {
      "frame": "idle",
      "motion": "held",
      "loop": false
    },
    "petting": {
      "frame": "idle",
      "motion": "nuzzle",
      "bubbleText": "哼，勉为其难让你摸摸耳朵~",
      "durationMs": 2400,
      "loop": false
    }
  },
  "audio": {
    "press": "audio/pop-press.wav",
    "release": "audio/pop-release.wav",
    "clickPress": "audio/click-press.wav",
    "clickRelease": "audio/click-release.wav"
  },
  "dialogue": "dialogue.json",
  "ui": {
    "thoughtSpeech": "ui/thought-speech.svg",
    "thoughtQuota": "ui/thought-quota.svg",
    "thoughtCost": "ui/thought-cost.svg"
  }
}
