{
  "name": "anti-pet-indesktop",
  "version": "0.1.0",
  "description": "大肥猫桌宠挂件 - Cross-platform lightweight desktop & in-IDE pet companion for Antigravity (Mac & Windows)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js --dev",
